<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="
        http://www.springframework.org/schema/beans 
        http://www.springframework.org/schema/beans/spring-beans.xsd
        http://www.springframework.org/schema/context
        http://www.springframework.org/schema/context/spring-context.xsd">
        
        
        
<!--  Enable component Scanning to detect user-defined classes annoted with @Component as spring beans -->
<context:component-scan base-package="S_beans"/>
<!-- Configure java classes as spring beans -->
  <bean id="ldate" class="java.time.LocalDate" factory-method="now"/><!-- Dependent Spring Bean -->
  
  </beans>